@startuml Diagrama ER
skinparam linetype ortho

' =========================
' ENTIDAD PRINCIPAL
' =========================

entity "afiliado" as afiliado {
    * id : SERIAL <<PK>>
    --
    * dni : VARCHAR(20) <<UNIQUE>>
    * nombre : VARCHAR(100)
    * apellido : VARCHAR(100)
    * fecha_nacimiento : DATE
    email : VARCHAR(150) <<UNIQUE>>
    telefono : VARCHAR(20)
    * numero_legajo : VARCHAR(50) <<UNIQUE>>
    fecha_ingreso : DATE
    fecha_alta : DATE
    titulo_obtenido : VARCHAR(150)
    * fecha_creacion : TIMESTAMP
    * fecha_actualizacion : TIMESTAMP
    --
    * id_genero : INTEGER <<FK>>
    * id_estado_civil : INTEGER <<FK>>
    * id_nivel_educativo : INTEGER <<FK>>
    * id_relacion_dependencia : INTEGER <<FK>>
    * id_estado_afiliado : INTEGER <<FK>>
    * id_domicilio : INTEGER <<FK>>
    id_importacion : INTEGER <<FK>>
}

' =========================
' IMPORTACION Y ERROR
' =========================

entity "importacion" as importacion {
    * id : SERIAL <<PK>>
    --
    * fecha_importacion : TIMESTAMP
    * cantidad_registros : INTEGER
    * cantidad_errores : INTEGER
    * estado : VARCHAR(50)
}

entity "error_validacion" as error {
    * id : SERIAL <<PK>>
    --
    registro_origen : VARCHAR(100)
    campo : VARCHAR(100)
    * descripcion_error : TEXT
    * fecha_error : TIMESTAMP
    * row_number : INTEGER
    --
    * id_importacion : INTEGER <<FK>>
}

' =========================
' DOMICILIO
' =========================

entity "domicilio" as domicilio {
    * id : SERIAL <<PK>>
    --
    direccion : VARCHAR(200)
    codigo_postal : VARCHAR(10)
    --
    * id_localidad : INTEGER <<FK>>
}

entity "localidad" as localidad {
    * id : SERIAL <<PK>>
    --
    * nombre : VARCHAR(100)
    --
    * id_provincia : INTEGER <<FK>>
}

entity "provincia" as provincia {
    * id : SERIAL <<PK>>
    --
    * nombre : VARCHAR(100)
}

' =========================
' ENTIDADES DE DOMINIO
' (valores controlados)
' =========================

entity "genero" as genero {
    * id : SERIAL <<PK>>
    --
    * descripcion : VARCHAR(50)
}

entity "estado_civil" as estado_civil {
    * id : SERIAL <<PK>>
    --
    * descripcion : VARCHAR(50)
}

entity "nivel_educativo" as nivel_educativo {
    * id : SERIAL <<PK>>
    --
    * descripcion : VARCHAR(100)
}

entity "relacion_dependencia" as relacion_dependencia {
    * id : SERIAL <<PK>>
    --
    * descripcion : VARCHAR(100)
}

entity "estado_afiliado" as estado_afiliado {
    * id : SERIAL <<PK>>
    --
    * descripcion : VARCHAR(50)
}

' =========================
' RELACIONES
' =========================

' Importacion → Afiliado (1 importacion genera muchos afiliados)
importacion ||--o{ afiliado : "genera"

' Importacion → ErrorValidacion (1 importacion genera muchos errores)
importacion ||--o{ error : "registra"

' Afiliado → Domicilio (1 a 1)
afiliado ||--|| domicilio : "tiene"

' Domicilio → Localidad → Provincia
domicilio }o--|| localidad : "pertenece a"
localidad }o--|| provincia : "pertenece a"

' Afiliado → Entidades de dominio
afiliado }o--|| genero : "tiene"
afiliado }o--|| estado_civil : "tiene"
afiliado }o--|| nivel_educativo : "tiene"
afiliado }o--|| relacion_dependencia : "tiene"
afiliado }o--|| estado_afiliado : "tiene"

@enduml
