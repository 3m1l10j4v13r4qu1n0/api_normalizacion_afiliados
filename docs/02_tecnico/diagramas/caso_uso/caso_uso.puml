@startuml Diagrama de Casos de Uso
skinparam linetype ortho
skinparam actorStyle awesome
skinparam packageStyle rectangle

left to right direction

' =========================
' ACTORES
' =========================

actor "Usuario\nAdministrativo" as admin
actor "Sistema\nCliente" as cliente
actor "Google\nSheets" as sheets <<system>>

' =========================
' SISTEMA
' =========================

rectangle "Sistema de Normalización de Datos de Afiliados" {

    ' --- Gestión de Afiliados ---
    package "Gestión de Afiliados" {
        usecase "UC1 — Importar Afiliado/s" as UC1
        usecase "UC1a — Importar afiliados\ndesde API (lista)" as UC1a
        usecase "UC1b — Registrar afiliado\nmanualmente" as UC1b
        usecase "UC2 — Consultar Afiliados" as UC2
        usecase "UC3 — Actualizar Afiliado" as UC3
        usecase "UC5 — Dar de baja Afiliado" as UC5
    }

    ' --- Sincronización ---
    package "Sincronización con Google Sheets" {
        usecase "UC4 — Importar desde\nGoogle Sheets" as UC4
        usecase "UC4a — Leer y transformar\ndatos desde Google Sheets" as UC4a
        usecase "UC4b — Marcar errores\nen Google Sheets" as UC4b
        usecase "UC6 — Generar tabla de\nafiliados en Google Sheets" as UC6
    }

}

' =========================
' RELACIONES — ACTORES
' =========================

admin --> UC1b
admin --> UC2
admin --> UC3
admin --> UC4
admin --> UC5
admin --> UC6

cliente --> UC1a
cliente --> UC2
cliente --> UC3
cliente --> UC5
cliente --> UC6

UC4a --> sheets
UC4b --> sheets
UC6  --> sheets

' =========================
' RELACIONES — CASOS DE USO
' =========================

UC1a ..|> UC1 : <<extends>>
UC1b ..|> UC1 : <<extends>>

UC4 ..> UC4a : <<include>>
UC4 ..> UC4b : <<include>>

@enduml
